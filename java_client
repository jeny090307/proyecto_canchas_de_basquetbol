package com.reservas.solana.model;

/**
 * Estado de una reserva. El discriminante (0-3) es el mismo orden en el
 * que el programa Anchor define el enum {@code EstadoReserva} en Rust,
 * por eso la decodificación Borsh puede mapear el byte directamente.
 */
public enum EstadoReserva {
    PENDIENTE(0),
    CONFIRMADA(1),
    COMPLETADA(2),
    CANCELADA(3);

    private final int discriminante;

    EstadoReserva(int discriminante) {
        this.discriminante = discriminante;
    }

    public int getDiscriminante() {
        return discriminante;
    }

    public static EstadoReserva desdeDiscriminante(int valor) {
        for (EstadoReserva estado : values()) {
            if (estado.discriminante == valor) {
                return estado;
            }
        }
        throw new IllegalArgumentException("Estado de reserva desconocido: " + valor);
    }
}

package com.reservas.solana.model;

import java.nio.ByteBuffer;
import java.nio.ByteOrder;
import java.nio.charset.StandardCharsets;
import java.util.Objects;

/**
 * Cuenta Cancha, tal como la define el programa Anchor.
 *
 * Layout Borsh (después del discriminador de 8 bytes de Anchor):
 * nombre (String), ubicacion (String), precio_por_hora (u64),
 * administrador (Pubkey, 32 bytes), activa (bool, 1 byte).
 */
public class Cancha {

    /** Espacio reservado en la cuenta, igual que Cancha::SPACE en Rust. */
    public static final int SPACE = 153;

    private final String nombre;
    private final String ubicacion;
    private final long precioPorHora;
    private final String administrador;
    private final boolean activa;

    public Cancha(String nombre, String ubicacion, long precioPorHora,
                  String administrador, boolean activa) {
        this.nombre = Objects.requireNonNull(nombre);
        this.ubicacion = Objects.requireNonNull(ubicacion);
        this.precioPorHora = precioPorHora;
        this.administrador = Objects.requireNonNull(administrador);
        this.activa = activa;
    }

    /** Decodifica los bytes de la cuenta (incluido el discriminador). */
    public static Cancha fromBytes(byte[] datos) {
        ByteBuffer buffer = ByteBuffer.wrap(datos).order(ByteOrder.LITTLE_ENDIAN);
        buffer.position(8); // discriminador de Anchor
        String nombre = leerString(buffer);
        String ubicacion = leerString(buffer);
        long precioPorHora = buffer.getLong();
        byte[] adminBytes = new byte[32];
        buffer.get(adminBytes);
        boolean activa = buffer.get() != 0;
        return new Cancha(nombre, ubicacion, precioPorHora,
                Base58Helper.encode(adminBytes), activa);
    }

    static String leerString(ByteBuffer buffer) {
        int longitud = buffer.getInt();
        byte[] bytes = new byte[longitud];
        buffer.get(bytes);
        return new String(bytes, StandardCharsets.UTF_8);
    }

    public String getNombre() {
        return nombre;
    }

    public String getUbicacion() {
        return ubicacion;
    }

    public long getPrecioPorHora() {
        return precioPorHora;
    }

    public String getAdministrador() {
        return administrador;
    }

    public boolean isActiva() {
        return activa;
    }

    @Override
    public String toString() {
        return "Cancha{nombre='" + nombre + "', ubicacion='" + ubicacion
                + "', precioPorHora=" + precioPorHora
                + ", administrador='" + administrador
                + "', activa=" + activa + "}";
    }
}

package com.reservas.solana.model;

import java.math.BigInteger;
import java.util.Arrays;

/**
 * Codificación Base58 (alfabeto de Bitcoin, el mismo que usa Solana).
 * Se usa para convertir claves públicas de 32 bytes a su forma legible
 * y viceversa, sin depender de otra librería.
 */
public final class Base58Helper {

    private static final String ALFABETO = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
    private static final BigInteger BASE = BigInteger.valueOf(58);

    private Base58Helper() {
    }

    public static String encode(byte[] entrada) {
        if (entrada.length == 0) {
            return "";
        }
        int ceros = 0;
        while (ceros < entrada.length && entrada[ceros] == 0) {
            ceros++;
        }
        BigInteger numero = new BigInteger(1, entrada);
        StringBuilder resultado = new StringBuilder();
        while (numero.compareTo(BigInteger.ZERO) > 0) {
            BigInteger[] division = numero.divideAndRemainder(BASE);
            numero = division[0];
            resultado.insert(0, ALFABETO.charAt(division[1].intValue()));
        }
        for (int i = 0; i < ceros; i++) {
            resultado.insert(0, '1');
        }
        return resultado.toString();
    }

    public static byte[] decode(String entrada) {
        BigInteger numero = BigInteger.ZERO;
        for (int i = 0; i < entrada.length(); i++) {
            int digito = ALFABETO.indexOf(entrada.charAt(i));
            if (digito < 0) {
                throw new IllegalArgumentException("Carácter Base58 inválido: " + entrada.charAt(i));
            }
            numero = numero.multiply(BASE).add(BigInteger.valueOf(digito));
        }
        byte[] bytes = numero.toByteArray();
        // BigInteger añade un byte de signo 0 al inicio cuando hace falta.
        if (bytes.length > 1 && bytes[0] == 0) {
            bytes = Arrays.copyOfRange(bytes, 1, bytes.length);
        }
        int ceros = 0;
        while (ceros < entrada.length() && entrada.charAt(ceros) == '1') {
            ceros++;
        }
        byte[] resultado = new byte[ceros + bytes.length];
        System.arraycopy(bytes, 0, resultado, ceros, bytes.length);
        return resultado;
    }
}

package com.reservas.solana.model;

import java.nio.ByteBuffer;
import java.nio.ByteOrder;
import java.util.Objects;

/**
 * Cuenta Reserva, tal como la define el programa Anchor.
 *
 * Layout Borsh (después del discriminador de 8 bytes de Anchor):
 * cancha (Pubkey, 32 bytes), usuario (Pubkey, 32 bytes),
 * fecha (String), hora_inicio (u8), inicio_unix (i64),
 * estado (enum, 1 byte), bump (u8).
 *
 * La regla de cancelación vive aquí como método puro, para que el
 * cliente, el frontend y las pruebas usen exactamente la misma regla
 * que el programa on-chain: más de 2 horas de antelación y estado
 * distinto de Completada/Cancelada. La regla on-chain (Clock sysvar)
 * es la autoritativa; esta es solo una comprobación previa en el
 * cliente para no enviar transacciones que van a fallar.
 */
public class Reserva {

    /** Espacio reservado en la cuenta, igual que Reserva::SPACE en Rust. */
    public static final int SPACE = 97;

    /** Ventana de cancelación en segundos, igual que en el programa. */
    public static final long VENTANA_CANCELACION_SEGUNDOS = 2 * 3600;

    private final String cancha;
    private final String usuario;
    private final String fecha;
    private final int horaInicio;
    private final long inicioUnix;
    private final EstadoReserva estado;
    private final int bump;

    public Reserva(String cancha, String usuario, String fecha, int horaInicio,
                   long inicioUnix, EstadoReserva estado, int bump) {
        this.cancha = Objects.requireNonNull(cancha);
        this.usuario = Objects.requireNonNull(usuario);
        this.fecha = Objects.requireNonNull(fecha);
        this.horaInicio = horaInicio;
        this.inicioUnix = inicioUnix;
        this.estado = Objects.requireNonNull(estado);
        this.bump = bump;
    }

    /** Decodifica los bytes de la cuenta (incluido el discriminador). */
    public static Reserva fromBytes(byte[] datos) {
        ByteBuffer buffer = ByteBuffer.wrap(datos).order(ByteOrder.LITTLE_ENDIAN);
        buffer.position(8); // discriminador de Anchor
        byte[] canchaBytes = new byte[32];
        buffer.get(canchaBytes);
        byte[] usuarioBytes = new byte[32];
        buffer.get(usuarioBytes);
        String fecha = Cancha.leerString(buffer);
        int horaInicio = Byte.toUnsignedInt(buffer.get());
        long inicioUnix = buffer.getLong();
        EstadoReserva estado = EstadoReserva.desdeDiscriminante(Byte.toUnsignedInt(buffer.get()));
        int bump = Byte.toUnsignedInt(buffer.get());
        return new Reserva(Base58Helper.encode(canchaBytes),
                Base58Helper.encode(usuarioBytes), fecha, horaInicio,
                inicioUnix, estado, bump);
    }

    /**
     * Regla de cancelación (pura, sin red): la cancelación está
     * permitida solo si faltan más de 2 horas para el inicio y el
     * estado no es Completada ni Cancelada.
     */
    public static boolean esCancelacionPermitida(long inicioUnix, long ahoraUnix,
                                                 EstadoReserva estado) {
        if (estado == EstadoReserva.COMPLETADA || estado == EstadoReserva.CANCELADA) {
            return false;
        }
        return inicioUnix - ahoraUnix > VENTANA_CANCELACION_SEGUNDOS;
    }

    /** Lo mismo, aplicado a esta reserva. */
    public boolean esCancelacionPermitida(long ahoraUnix) {
        return esCancelacionPermitida(inicioUnix, ahoraUnix, estado);
    }

    public String getCancha() {
        return cancha;
    }

    public String getUsuario() {
        return usuario;
    }

    public String getFecha() {
        return fecha;
    }

    public int getHoraInicio() {
        return horaInicio;
    }

    public long getInicioUnix() {
        return inicioUnix;
    }

    public EstadoReserva getEstado() {
        return estado;
    }

    public int getBump() {
        return bump;
    }

    @Override
    public String toString() {
        return "Reserva{cancha='" + cancha + "', usuario='" + usuario
                + "', fecha='" + fecha + "', horaInicio=" + horaInicio
                + ", inicioUnix=" + inicioUnix + ", estado=" + estado
                + ", bump=" + bump + "}";
    }
}

package com.reservas.solana.wallet;

import com.google.gson.JsonArray;
import com.google.gson.JsonParser;
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.Optional;
import org.p2p.solanaj.core.Account;
import org.p2p.solanaj.core.PublicKey;

/**
 * Conexión de wallet para la demostración en devnet.
 *
 * <p>En este proyecto la "wallet" es un keypair local en formato JSON de
 * Solana CLI (un array de 64 números, como el que genera
 * {@code solana-keygen new}). El frontend JavaFX lo carga desde un
 * archivo elegido por el usuario y lo usa solo para firmar.</p>
 *
 * <p><b>Advertencias de seguridad:</b></p>
 * <ul>
 *   <li>Solo para <b>devnet</b> y con un keypair creado para las pruebas.</li>
 *   <li><b>Nunca</b> uses aquí un keypair de mainnet ni un keypair con
 *       fondos reales.</li>
 *   <li><b>Nunca</b> subas un archivo de keypair a GitHub: está cubierto
 *       por el {@code .gitignore} del repositorio.</li>
 *   <li>En una aplicación real, la wallet sería una extensión como
 *       Phantom y la clave privada nunca saldría de ella.</li>
 * </ul>
 */
public class WalletService {

    private Account cuenta;

    /** Conecta una wallet a partir de un keypair en formato JSON. */
    public PublicKey conectar(Path archivoKeypair) throws IOException {
        String contenido = Files.readString(archivoKeypair);
        JsonArray numeros = JsonParser.parseString(contenido).getAsJsonArray();
        if (numeros.size() != 64) {
            throw new IllegalArgumentException(
                    "El keypair debe tener 64 bytes (formato de solana-keygen)");
        }
        byte[] claveSecreta = new byte[64];
        for (int i = 0; i < 64; i++) {
            claveSecreta[i] = (byte) numeros.get(i).getAsInt();
        }
        this.cuenta = new Account(claveSecreta);
        return cuenta.getPublicKey();
    }

    /** Desconecta la wallet y olvida la clave en memoria. */
    public void desconectar() {
        this.cuenta = null;
    }

    public boolean estaConectado() {
        return cuenta != null;
    }

    public Optional<PublicKey> getPublicKey() {
        return cuenta == null
                ? Optional.empty()
                : Optional.of(cuenta.getPublicKey());
    }

    /**
     * La cuenta que firma las transacciones. Lanza excepción si no hay
     * wallet conectada.
     */
    public Account getCuenta() {
        if (cuenta == null) {
            throw new IllegalStateException("No hay ninguna wallet conectada");
        }
        return cuenta;
    }
}

