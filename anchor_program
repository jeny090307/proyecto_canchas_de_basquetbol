#[derive(Accounts)]
pub struct CrearCancha<'info> {
    #[account(
        init,
        payer = administrador,
        space = Cancha::SPACE,
    )]
    pub cancha: Account<'info, Cancha>,
    #[account(mut)]
    pub administrador: Signer<'info>,
    pub system_program: Program<'info, System>,
}

#[derive(Accounts)]
#[instruction(fecha: String, hora_inicio: u8)]
pub struct CrearReserva<'info> {
    #[account(
        init,
        payer = usuario,
        space = Reserva::SPACE,
        seeds = [b"reserva", cancha.key().as_ref(), fecha.as_bytes(), &[hora_inicio]],
        bump,
    )]
    pub reserva: Account<'info, Reserva>,
    #[account(mut)]
    pub cancha: Account<'info, Cancha>,
    #[account(mut)]
    pub usuario: Signer<'info>,
    pub system_program: Program<'info, System>,
}

#[derive(Accounts)]
pub struct ConfirmarReserva<'info> {
    #[account(
        mut,
        has_one = cancha,
        constraint = administrador.key() == cancha.administrador
            @ ErrorCode::AccesoNoAutorizado,
    )]
    pub reserva: Account<'info, Reserva>,
    pub cancha: Account<'info, Cancha>,
    pub administrador: Signer<'info>,
}

#[derive(Accounts)]
#[instruction(nueva_hora_inicio: u8)]
pub struct CambiarHora<'info> {
    #[account(
        mut,
        close = usuario,
        has_one = cancha,
        has_one = usuario,
    )]
    pub reserva_antigua: Account<'info, Reserva>,
    #[account(
        init,
        payer = usuario,
        space = Reserva::SPACE,
        seeds = [b"reserva", cancha.key().as_ref(), reserva_antigua.fecha.as_bytes(), &[nueva_hora_inicio]],
        bump,
    )]
    pub reserva_nueva: Account<'info, Reserva>,
    pub cancha: Account<'info, Cancha>,
    #[account(mut)]
    pub usuario: Signer<'info>,
    pub system_program: Program<'info, System>,
}

#[derive(Accounts)]
pub struct CompletarReserva<'info> {
    #[account(
        mut,
        has_one = cancha,
        constraint = administrador.key() == cancha.administrador
            @ ErrorCode::AccesoNoAutorizado,
    )]
    pub reserva: Account<'info, Reserva>,
    pub cancha: Account<'info, Cancha>,
    pub administrador: Signer<'info>,
}

#[derive(Accounts)]
pub struct CancelarReserva<'info> {
    #[account(
        mut,
        close = usuario,
        has_one = cancha,
        has_one = usuario,
    )]
    pub reserva: Account<'info, Reserva>,
    pub cancha: Account<'info, Cancha>,
    #[account(mut)]
    pub usuario: Signer<'info>,
}

// ---------------------------------------------------------------------------
// Datos guardados en las cuentas
// ---------------------------------------------------------------------------

#[account]
pub struct Cancha {
    /// Nombre de la cancha, máx. 32 caracteres.
    pub nombre: String,
    /// Ubicación, máx. 64 caracteres.
    pub ubicacion: String,
    /// Precio por hora, en lamports.
    pub precio_por_hora: u64,
    /// Wallet del administrador que la creó.
    pub administrador: Pubkey,
    /// Si es false, no se aceptan reservas nuevas.
    pub activa: bool,
}

impl Cancha {
    /// 8 (discriminador) + (4 + 32) nombre + (4 + 64) ubicación
    /// + 8 precio + 32 administrador + 1 activa.
    pub const SPACE: usize = 8 + 36 + 68 + 8 + 32 + 1;
}

#[account]
pub struct Reserva {
    /// Cancha reservada.
    pub cancha: Pubkey,
    /// Wallet del usuario que reservó.
    pub usuario: Pubkey,
    /// Fecha en formato `YYYY-MM-DD`.
    pub fecha: String,
    /// Hora de inicio (0-23).
    pub hora_inicio: u8,
    /// Inicio de la reserva en segundos desde epoch (UTC).
    pub inicio_unix: i64,
    /// Estado actual de la reserva.
    pub estado: EstadoReserva,
    /// Bump de la PDA.
    pub bump: u8,
}

impl Reserva {
    /// 8 (discriminador) + 32 cancha + 32 usuario + (4 + 10) fecha
    /// + 1 hora_inicio + 8 inicio_unix + 1 estado + 1 bump.
    pub const SPACE: usize = 8 + 32 + 32 + 14 + 1 + 8 + 1 + 1;
}

#[derive(AnchorSerialize, AnchorDeserialize, Clone, PartialEq, Eq)]
pub enum EstadoReserva {
    Pendiente,
    Confirmada,
    Completada,
    Cancelada,
}

// ---------------------------------------------------------------------------
// Errores propios del programa
// ---------------------------------------------------------------------------

#[error_code]
pub enum ErrorCode {
    #[msg("Solo el administrador o el dueño pueden realizar esta operación.")]
    AccesoNoAutorizado,
    #[msg("La cancelación no está permitida: faltan menos de 2 horas para el inicio o la reserva ya está completada/cancelada.")]
    CancelacionNoPermitida,
    #[msg("La reserva no está en estado Pendiente.")]
    ReservaNoPendiente,
    #[msg("La reserva no está en estado Confirmada.")]
    ReservaNoConfirmada,
    #[msg("La hora de inicio debe estar entre 0 y 23.")]
    HoraInvalida,
    #[msg("La fecha debe tener formato YYYY-MM-DD (10 caracteres).")]
    FechaInvalida,
    #[msg("La cancha no está activa.")]
    CanchaInactiva,
    #[msg("El precio por hora debe ser mayor que cero.")]
    PrecioInvalido,
    #[msg("El texto supera la longitud máxima permitida.")]
    TextoDemasiadoLargo,
}

