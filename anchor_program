//! Programa de reservas de canchas de básquetbol en Solana.
//!
//! Cuentas:
//! * `Cancha`: la crea un administrador con una keypair generada por el
//!   cliente. Guarda nombre, ubicación, precio por hora y su administrador.
//! * `Reserva`: PDA derivada de las seeds
//!   `["reserva", cancha_pubkey, fecha, hora_inicio]`.
//!   La PDA es única por cancha + fecha + hora, por lo que un horario no
//!   se puede reservar dos veces: si la PDA ya existe, `crear_reserva`
//!   falla al intentar inicializarla.
//!
//! La fecha se guarda como texto `YYYY-MM-DD` (legible en el frontend) y
//! además como `inicio_unix` (segundos desde epoch, UTC), que es lo que
//! el programa usa para la regla de cancelación (> 2 horas de antelación).
//! El cliente calcula `inicio_unix` a partir de la fecha y la hora; el
//! programa nunca confía en un reloj enviado por el cliente: para la
//! cancelación usa el sysvar `Clock` on-chain.

use anchor_lang::prelude::*;
use anchor_lang::solana_program::sysvar::Sysvar;

declare_id!("BaRjCPQHBAyEYu8MGLTv9vwsofnrK6BqZcPAK3kKk2tZ");

/// Dos horas, en segundos. Una reserva solo puede cancelarse si faltan
/// más de `VENTANA_CANCELACION_SEGUNDOS` para su inicio.
pub const VENTANA_CANCELACION_SEGUNDOS: i64 = 2 * 3600;

#[program]
pub mod reservas_canchas {
    use super::*;

    /// Crea una cancha. Solo la firma quien paga la cuenta; ese firmante
    /// queda registrado como administrador de la cancha.
    pub fn crear_cancha(
        ctx: Context<CrearCancha>,
        nombre: String,
        ubicacion: String,
        precio_por_hora: u64,
    ) -> Result<()> {
        require!(nombre.len() <= 32, ErrorCode::TextoDemasiadoLargo);
        require!(ubicacion.len() <= 64, ErrorCode::TextoDemasiadoLargo);
        require!(precio_por_hora > 0, ErrorCode::PrecioInvalido);

        ctx.accounts.cancha.set_inner(Cancha {
            nombre,
            ubicacion,
            precio_por_hora,
            administrador: *ctx.accounts.administrador.key,
            activa: true,
        });
        Ok(())
    }

    /// Crea una reserva en estado Pendiente.
    ///
    /// La cuenta `reserva` es una PDA con seeds
    /// `["reserva", cancha, fecha, hora_inicio]`. Si esa PDA ya existe
    /// (el horario ya está reservado), la inicialización falla y la
    /// transacción se revierte: es la garantía on-chain contra la doble
    /// reserva, sin depender del frontend.
    pub fn crear_reserva(
        ctx: Context<CrearReserva>,
        fecha: String,
        hora_inicio: u8,
        inicio_unix: i64,
    ) -> Result<()> {
        require!(fecha.len() == 10, ErrorCode::FechaInvalida);
        require!(hora_inicio <= 23, ErrorCode::HoraInvalida);
        require!(ctx.accounts.cancha.activa, ErrorCode::CanchaInactiva);

        ctx.accounts.reserva.set_inner(Reserva {
            cancha: ctx.accounts.cancha.key(),
            usuario: *ctx.accounts.usuario.key,
            fecha,
            hora_inicio,
            inicio_unix,
            estado: EstadoReserva::Pendiente,
            bump: ctx.bumps.reserva,
        });
        Ok(())
    }

    /// Confirma una reserva Pendiente. Solo el administrador de la cancha.
    pub fn confirmar_reserva(ctx: Context<ConfirmarReserva>) -> Result<()> {
        let reserva = &mut ctx.accounts.reserva;
        require!(
            reserva.estado == EstadoReserva::Pendiente,
            ErrorCode::ReservaNoPendiente
        );
        reserva.estado = EstadoReserva::Confirmada;
        Ok(())
    }

    /// Cambia la hora de una reserva Pendiente. Solo su dueño.
    ///
    /// La hora forma parte de las seeds de la PDA, así que cambiarla
    /// significa cambiar de cuenta: la instrucción cierra la PDA antigua
    /// (devolviendo sus lamports al usuario) y crea la PDA nueva con las
    /// seeds del horario nuevo. Si el horario nuevo ya está ocupado, la
    /// inicialización de la PDA nueva falla y no se pierde la reserva
    /// antigua, porque la transacción completa se revierte.
    pub fn cambiar_hora(
        ctx: Context<CambiarHora>,
        nueva_hora_inicio: u8,
        nuevo_inicio_unix: i64,
    ) -> Result<()> {
        require!(nueva_hora_inicio <= 23, ErrorCode::HoraInvalida);
        let antigua = &ctx.accounts.reserva_antigua;
        require!(
            antigua.estado == EstadoReserva::Pendiente,
            ErrorCode::ReservaNoPendiente
        );
        require!(
            nueva_hora_inicio != antigua.hora_inicio,
            ErrorCode::HoraInvalida
        );

        ctx.accounts.reserva_nueva.set_inner(Reserva {
            cancha: antigua.cancha,
            usuario: antigua.usuario,
            fecha: antigua.fecha.clone(),
            hora_inicio: nueva_hora_inicio,
            inicio_unix: nuevo_inicio_unix,
            estado: EstadoReserva::Pendiente,
            bump: ctx.bumps.reserva_nueva,
        });
        Ok(())
    }

    /// Marca una reserva Confirmada como Completada (la cancha ya se usó).
    /// Solo el administrador de la cancha. Una reserva Completada ya no
    /// se puede cancelar: esa es la otra mitad de la regla de cierre.
    pub fn completar_reserva(ctx: Context<CompletarReserva>) -> Result<()> {
        let reserva = &mut ctx.accounts.reserva;
        require!(
            reserva.estado == EstadoReserva::Confirmada,
            ErrorCode::ReservaNoConfirmada
        );
        reserva.estado = EstadoReserva::Completada;
        Ok(())
    }

    /// Cancela una reserva y cierra su cuenta.
    ///
    /// Regla del programa (cierre condicionado): solo se cierra si
    /// faltan más de 2 horas para el inicio (`inicio_unix - ahora >
    /// 7200`) y el estado no es `Completada` (ni `Cancelada`). Si no se
    /// cumple, la transacción falla con `CancelacionNoPermitida` y la
    /// cuenta sigue existiendo. Al cerrarse, los lamports de la renta se
    /// devuelven al usuario (`close = usuario`).
    pub fn cancelar_reserva(ctx: Context<CancelarReserva>) -> Result<()> {
        let reserva = &ctx.accounts.reserva;
        require!(
            reserva.estado != EstadoReserva::Completada
                && reserva.estado != EstadoReserva::Cancelada,
            ErrorCode::CancelacionNoPermitida
        );
        let ahora = Clock::get()?.unix_timestamp;
        require!(
            reserva.inicio_unix - ahora > VENTANA_CANCELACION_SEGUNDOS,
            ErrorCode::CancelacionNoPermitida
        );
        // No hace falta poner estado = Cancelada: la cuenta se cierra
        // con `close = usuario` en el struct de cuentas.
        Ok(())
    }
}

