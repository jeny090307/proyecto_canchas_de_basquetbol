name: CI

on:
  push:
  pull_request:

jobs:
  anchor:
    name: Programa Anchor (Rust)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Instalar Solana CLI
        run: |
          sh -c "$(curl -sSfL https://release.anza.xyz/stable/install)"
          echo "$HOME/.local/share/solana/install/active_release/bin" >> "$GITHUB_PATH"
      - name: Instalar Anchor CLI 0.30.1
        run: |
          cargo install --git https://github.com/coral-xyz/anchor --tag v0.30.1 anchor-cli --locked
      - name: Instalar dependencias de Node
        working-directory: anchor-program
        run: npm ci
      - name: Compilar programa
        working-directory: anchor-program
        run: anchor build
      - name: Probar programa (validador local)
        working-directory: anchor-program
        run: anchor test --skip-deploy

  java:
    name: Cliente Java y frontend JavaFX
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Instalar JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"
          cache: maven
      - name: Instalar cliente Java
        working-directory: java-client
        run: mvn --batch-mode clean install
      - name: Compilar frontend JavaFX
        working-directory: javafx-frontend
        run: mvn --batch-mode clean verify -DskipTests
